{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleShare",
  "version": "0.2.0",
  "identifier": "dev.simpleshare.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost https://github.com https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "resources": {"../THIRD_PARTY_LICENSES.txt":"THIRD_PARTY_LICENSES.txt","../LICENSE":"LICENSE.txt","../public/assets/licenses/Geist-OFL.txt":"Geist-OFL.txt"},
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRjU3N0NFNTcwQ0I4NDAKUldSQXVBeFh6bmYxRXNOVHFUSS92cm1kYStQVGdyd2ZHYnpBd0R2bVc3VjRNOE5Ea3hBaCs0U3IK",
      "endpoints": [
        "https://github.com/gustartzofficial-dev/SimpleShare-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
